import("//build/package.gni")

executable("bin") {
  output_name = "dd"

  sources = [
    "main.c",
  ]

  public_deps = [
    "//garnet/public/lib/app/cpp",
    "//zircon/public/lib/zx",
    "//zircon/public/lib/fdio",
  ]
}

package("dd") {
  system_image = true

  deps = [
    ":bin",
  ]

  binaries = [
    {
      name = "dd"
    },
  ]
}

