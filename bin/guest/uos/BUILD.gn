# The UOS guest images for QEMU platform are prebuilt images in
# third_party/ree-trusty/nbl_vmm/data, we do not need to build
# the linux kernel and rootfs

package("uos") {
  deps = [
    "//garnet/bin/guest:bin",
  ]

  binary = "guest"

  meta = [
    {
      path = rebase_path("//garnet/bin/guest/meta/sandbox")
      dest = "sandbox"
    },
  ]
}
