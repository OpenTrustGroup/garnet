import("//build/package.gni")

executable("guest_manager_tests") {
  testonly = true

  sources = [
    "../guest_manager.cc",
    "../guest_manager_reporter.cc",
    "guest_manager_state_unittest.cc",
    "guest_manager_test.cc",
  ]

  deps = [
    "//garnet/bin/guest_manager/tests/lib",
    "//garnet/bin/guest_manager/proto:config",
    "//garnet/lib/machina",
    "//garnet/public/lib/app/cpp",
    "//garnet/public/lib/fxl",
    "//garnet/public/lib/virtualization/fidl",
    "//zircon/public/lib/async-loop",
    "//zircon/public/lib/async-loop-cpp",
    "//third_party/ree-trusty/libnebula-cpp:nebula-base",
    "//third_party/googletest:gtest_main",
    "//third_party/boringssl",
  ]
}

package("tests") {
  testonly = true
  system_image = true

  package_name = "guest_manager_tests"

  deps = [
    ":guest_manager_tests",
  ]

  tests = [
    {
      name = "guest_manager_tests"
    },
  ]
}
