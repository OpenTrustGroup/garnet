import("//build/config/fuchsia/rules.gni")
import("//build/package.gni")

driver_module("mt8668_ufs_drv") {
  output_name = "mt8668_ufs"

  sources = [
    "../core/ufs_core.c",
    "../core/ufs_hcd.c",
    "../core/ufs_interface.c",
    "../core/ufs_quirks.c",
    "../core/ufs_utils.c",
    "../core/ufs_crypto.c",
    "../core/ufs_rpmb.c",
    "../ufs.c",
    "../core/ufs_debug.c",
    "../vrpmb/virtio_rpmb.c",
    "../vrpmb/ipc_vqueue_be.c",
    "ufs_platform.c"
  ]

  defines = [ "_ALL_SOURCE=1", "MTK_UFS_8668" ]
  include_dirs = [ "../include/","../mt8668/","../core/inc/","../vrpmb/"]

  deps = [
    "//zircon/public/lib/ddk",
    "//zircon/public/lib/driver",
    "//zircon/public/lib/sync",
    "//zircon/public/lib/pretty",
    "//zircon/public/lib/zx",
    "//zircon/trusty/lib/lib/libc-trusty",
    "//garnet/lib/vm_id",
    "//garnet/public/lib/blk_crypto",
  ]
}

package("ufs") {
  system_image = true

  deps = [
    ":mt8668_ufs_drv",
  ]

   drivers = [
     {
       name = "mt8668_ufs.so"
     },
   ]
}
