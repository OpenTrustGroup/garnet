import("//build/config/fuchsia/rules.gni")
import("//build/package.gni")

driver_module("mt8678_board_drv") {
  output_name = "mt8678"

  sources = [
    "mt8678-board.c",
    "mt8678-wdt.c",
    "mt8675-ufs.c",
  ]

  defines = [ "_ALL_SOURCE=1" ]

  deps = [
    "//zircon/public/lib/ddk",
    "//zircon/public/lib/driver",
    "//zircon/public/lib/zx",
    "//garnet/drivers/soc/mt8678",
  ]
}

package("mt8678") {
  system_image = true

  deps = [
    ":mt8678_board_drv",
  ]

   drivers = [
     {
       name = "mt8678.so"
     },
   ]
}
