import("//build/package.gni")

# This is the simplest application in garent.
# For size and memory testing.
executable("bin") {
  output_name = "simplest-garnet-app"

  sources = [
    "main.c",
  ]

  libs = [
    "zircon",
  ]

  ldflags = [ "-z", "max-page-size=4096" ]
}

package("simplest-garnet-app") {
  system_image = true

  deps = [
    ":bin",
    "//garnet/examples/simplest-garnet-shared-lib",
    "//garnet/examples/simplest-garnet-static-lib",
  ]

  binaries = [ {
        name = "simplest-garnet-app" in_image="!release"
      } ]
}
