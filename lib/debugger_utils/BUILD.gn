# A collection of utilities useful to debuggers and similar programs.

import("//build/package.gni")

static_library("debugger_utils") {
  sources = [
    "build_ids.cc",
    "build_ids.h",
    "byte_block.h",
    "byte_block_file.cc",
    "byte_block_file.h",
    "elf_reader.cc",
    "elf_reader.h",
    "elf_symtab.cc",
    "elf_symtab.h",
    "ktrace_reader.cc",
    "ktrace_reader.h",
    "load_maps.cc",
    "load_maps.h",
    "util.cc",
    "util.h",
  ]

  if (is_fuchsia) {
    sources += [
      "dso_list.cc",
      "dso_list.h",
      "util_zx.cc",
    ]
  }

  if (current_cpu == "x64") {
    sources += [
      "x86_cpuid.cc",
      "x86_cpuid.h",
      "x86_pt.cc",
      "x86_pt.h",
    ]
  }

  deps = [
    "//garnet/public/lib/fxl",
  ]

  if (is_fuchsia) {
    deps += [ "//zircon/public/lib/zx" ]
  } else {
    deps += [ "//zircon/system/public" ]
  }
}

group("tests") {
  testonly = true

  deps = [
    ":util-unittests",
  ]
}

executable("util-unittests") {
  testonly = true

  sources = [
    "run_all_unittests.cc",
    "util.cc",
    "util.h",
    "util_unittest.cc",
    "util_zx.cc",
  ]

  deps = [
    ":debugger_utils",
    "//garnet/public/lib/fxl",
    "//third_party/googletest:gtest",
  ]

  libs = [ "zircon" ]
}

executable("ktrace_reader_bin") {
  output_name = "ktrace_reader"

  sources = [
    "ktrace_reader.cc",
    "ktrace_reader.h",
  ]

  defines = [
    "TEST",
  ]

  deps = [
    "//garnet/public/lib/fxl",
  ]

  libs = [ "zircon" ]
}

package("ktrace_reader") {
  system_image = true

  deps = [
    ":ktrace_reader_bin",
  ]

  binaries = [ {
    name = "ktrace_reader"
  } ]
}

source_set("minigzip") {
  sources = [
    "minigzip.c",
    "minigzip.h",
  ]

  deps = [
    "//third_party/zlib",
  ]
}

source_set("base64") {
  sources = [
    "base64.c",
    "base64.h",
  ]
}

executable("ktrace_vcpu_bin") {
  output_name = "ktrace_vcpu_reader"

  sources = [
    "ktrace_vcpu_reader.cc",
  ]

  deps = [
    "//garnet/public/lib/fxl",
    ":minigzip",
    ":base64",
  ]

  libs = [ "zircon" ]
}

package("ktrace_vcpu_reader") {
  system_image = true

  deps = [
    ":ktrace_vcpu_bin",
  ]

  binaries = [ {
    name = "ktrace_vcpu_reader"
  } ]
}
