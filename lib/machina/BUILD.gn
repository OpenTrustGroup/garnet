      "arch/x86/io_port.h",
      "arch/x86/page_table.cc",
      "arch/x86/page_table.h",
      "arch/x86/tpm.h",
    ]

    include_dirs = [ "//zircon/third_party/lib/acpica/source/include" ]
  }

  public_deps = [
    ":watchdog_policy",
    "//garnet/bin/guest/proto:vm_config",
    "//garnet/lib/machina/fidl",
    "//garnet/lib/vm_id",
