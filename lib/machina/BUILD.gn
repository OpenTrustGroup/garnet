    "zz-malloc.cc",
    "gpt_parse.cc",
    "ipc_vqueue_fe.c",
    "virtio_console.cc",
    "virtio_console.h",
    "virtio_device.cc",
    "virtio_device.h",
    "virtio_eint.cc",
    "virtio_eint.h",
    "virtio_gpu.cc",
    "virtio_gpu.h",
    "virtio_input.cc",
