    "gpu_scanout.cc",
    "gpu_scanout.h",
    "guest.cc",
    "guest.h",
    "guest_config.h",
    "reg_access.cc",
    "reg_access.h",
    "hid_event_source.cc",
    "hid_event_source.h",
