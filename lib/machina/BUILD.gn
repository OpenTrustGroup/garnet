    "//garnet/public/lib/spi_transport/cpp",
    "//zircon/public/lib/bitmap",
    "//zircon/public/lib/ddk",
    "//zircon/public/lib/hid",
    "//zircon/public/lib/virtio",
    "//zircon/public/lib/zx",
    "//garnet/bin/suspend:lib",
  ]

  defines = [
    "_ALL_SOURCE=1",
    "_VHM_USE_CHANNEL_",
    "RPROC_NOTIFY_WITH_PHYS_IRQ",
    "WITH_CROSS_VM_DUMP",
#    "VHE_MMIO_TRAP_DEBUG"
