library machina;

[ServiceName="machina.GpuPingService"]
interface GpuPingService {
  1: GetPingIrq(uint16 vmid) -> (uint32 irq);
  2: GetFifoBufVmo(uint16 vmid) -> (handle<vmo> fifo_vmo);
};