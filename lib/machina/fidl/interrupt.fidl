library machina;

[ServiceName="machina.InterruptService"]
interface InterruptService {
  1: MovePassthroughToUos(vector<uint16> irqs) -> ();

  // Android/UOS requests the Yocto/SOS-owned physical GPU IRQ.
  2: RaiseTimeSlicedIrq(uint32 irq) -> (int32 @status);
};
