library machina;

[ServiceName="machina.IpcMessageService"]
interface IpcMessageService {
  1: GetTraceBuf() -> (uint64 paddr, uint64 size);
  3: GetMonitorVirtioMem() -> (uint64 paddr, uint64 size);
  4: GetDeviceTree() -> (uint64 paddr, uint64 size);
  5: GetCvmdBuf() -> (uint64 paddr, uint64 size);
};